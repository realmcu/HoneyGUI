# for module compiling
import os
import sys

from building import *

cwd = GetCurrentDir()
inc = [cwd]

src = []
if GetDepend(['CONFIG_REALTEK_BUILD_EXAMPLE_SYSVAL_REQUEST']):
    src = ['example_sysval_request.c']
if GetDepend(['CONFIG_REALTEK_BUILD_EXAMPLE_SYSVAL_SUBSCRIBE']):
    src = ['example_sysval_subscribe.c']

if src:
    CPPDEFINES = ['DRV_LCD_WIDTH=480']
    CPPDEFINES += ['DRV_LCD_HEIGHT=480']
    CPPDEFINES += ['DRV_PIXEL_BITS=16']
    objs = DefineGroup('example/sysval', src, depend = [''], CPPPATH = inc, CPPDEFINES = CPPDEFINES)
    list = os.listdir(cwd)
    for d in list:
        path = os.path.join(cwd, d)
        if os.path.isfile(os.path.join(path, 'SConscript')):
            objs = objs + SConscript(os.path.join(d, 'SConscript'))
else:
    objs = []

Return('objs')
