# for module compiling
import os
import sys

from building import *

cwd = GetCurrentDir()
inc = [cwd, Dir('..')]
src = Glob('*.c')

# These tests use gui_geometry and gui_list as scaffolding: coloured frames for
# the layout alignment grid, and a scrolling list for the language picker. Both
# are deleted in nano, so these never build; the sources stay for reference.
if GetDepend(['CONFIG_REALTEK_BUILD_EXAMPLE_TEXT_WIDGET']) and \
        GetDepend(['CONFIG_REALTEK_GUI_WIDGET_GEOMETRY']) and \
        GetDepend(['CONFIG_REALTEK_GUI_WIDGET_LIST']):
    CPPDEFINES = ['DRV_LCD_WIDTH=480', 'DRV_LCD_HEIGHT=480', 'DRV_PIXEL_BITS=16']
    objs = DefineGroup('example/widget/text', src, depend = [''], CPPPATH = inc,
                       CPPDEFINES = CPPDEFINES)
else:
    objs = []

Return('objs')
