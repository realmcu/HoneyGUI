CONFIG_REALTEK_HONEYGUI=y

#
# HoneyGUI Feature Configuration
#
# CONFIG_REALTEK_BUILD_LETTER_SHELL is not set
# CONFIG_REALTEK_BUILD_MONKEY_TEST is not set
CONFIG_REALTEK_H264_DECODER=y
# CONFIG_REALTEK_H264BSD is not set
# CONFIG_REALTEK_BUILD_GUI_BOX2D is not set
# CONFIG_REALTEK_BUILD_LITE3D is not set
