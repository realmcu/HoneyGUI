CONFIG_REALTEK_GUI_WIDGET_LIST=y
CONFIG_REALTEK_GUI_WIDGET_SVG=y
CONFIG_REALTEK_GUI_WIDGET_GIF=y
CONFIG_REALTEK_GUI_WIDGET_GLASS=y
CONFIG_REALTEK_GUI_WIDGET_LOTTIE=y
CONFIG_REALTEK_GUI_WIDGET_VIDEO=y
CONFIG_REALTEK_GUI_WIDGET_LITE_VIDEO=y
CONFIG_REALTEK_GUI_WIDGET_STREAM=y
CONFIG_REALTEK_GUI_WIDGET_QBCODE=y
CONFIG_REALTEK_GUI_WIDGET_SOCCER=y
