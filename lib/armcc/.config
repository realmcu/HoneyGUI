# CONFIG_REALTEK_BUILD_PARTICLE_SYSTEM is not set
# CONFIG_REALTEK_MINIMP3 is not set
# CONFIG_REALTEK_BUILD_AUDIO is not set
# end of HoneyGUI Feature Configuration

#
# HoneyGUI Widget Configuration
#
CONFIG_REALTEK_GUI_WIDGET_OBJ=y
