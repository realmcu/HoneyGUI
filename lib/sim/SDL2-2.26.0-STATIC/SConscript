from building import *
import sys
import os

cwd = GetCurrentDir()

src = []

if sys.platform == 'win32':
    # Library path and include path for Windows
    libpath = [os.path.join(cwd, 'lib')]
    include = [os.path.join(cwd, 'include', 'SDL2')]
    
    # Export library path to environment
    Import('env')
    env.Append(LIBPATH = libpath)
    env.Append(CPPPATH = include)
else:  # Linux/WSL - use system SDL2
    # Override via SDL2_INCLUDE_DIR / SDL2_LIB_DIR for setups without root
    # access, e.g. a locally-extracted libsdl2-dev package. Each may list
    # multiple os.pathsep-separated dirs, since Debian/Ubuntu splits SDL2.h
    # from the arch-specific SDL_config.h (under .../<triplet>/SDL2/).
    # Falls back to the standard system location.
    include = os.environ.get('SDL2_INCLUDE_DIR', '/usr/include/SDL2').split(os.pathsep)
    libpath = [p for p in os.environ.get('SDL2_LIB_DIR', '').split(os.pathsep) if p]

    Import('env')
    env.Append(CPPPATH = include, LIBPATH = libpath)


objs = DefineGroup('rtk_gui', src, depend = [''])

Return('objs')
