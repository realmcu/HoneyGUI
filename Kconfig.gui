# HoneyGUI Configuration

menuconfig REALTEK_HONEYGUI
    bool "Enable HoneyGUI Framework"
    default n
    select REALTEK_GUI_WIDGET_OBJ
    select REALTEK_GUI_WIDGET_IMG
    select REALTEK_GUI_WIDGET_WIN
    select REALTEK_GUI_WIDGET_TEXT
    help
      Enable Realtek HoneyGUI graphics framework

      The four selected widgets are the mandatory core of this release; see
      "HoneyGUI Widget Configuration" for why they cannot be turned off yet.

if REALTEK_HONEYGUI

choice
    prompt "Select HoneyGUI Demo"
    default REALTEK_BUILD_EXAMPLE_IMAGE_WIDGET
    optional
    depends on !REALTEK_BUILD_HONEYGUI_APP
    help
      Select one demo to build (mutually exclusive, or select none).
      Cannot be selected when Build HoneyGUI APP is enabled.

config REALTEK_BUILD_EXAMPLE_IMAGE_WIDGET
    bool "Image Widget Demo"
    help
      HoneyGUI Base Demo - Image Widget

config REALTEK_BUILD_EXAMPLE_GIF_WIDGET
    bool "GIF Widget Demo"
    select REALTEK_GUI_WIDGET_GIF
    help
      HoneyGUI Base Demo - GIF Widget (Animated GIF support)

config REALTEK_BUILD_EXAMPLE_TEXT_WIDGET
    bool "Text Widget Demo"
    select REALTEK_GUI_WIDGET_GEOMETRY
    select REALTEK_GUI_WIDGET_LIST
    select REALTEK_GUI_WIDGET_VIEW
    help
      HoneyGUI Base Demo - Text Widget

config REALTEK_BUILD_EXAMPLE_SYSVAL_REQUEST
    bool "System Value Request Demo"
    help
      HoneyGUI system value request demo showing standard
      platform-independent values through the asynchronous sysval API.

config REALTEK_BUILD_EXAMPLE_SYSVAL_SUBSCRIBE
    bool "System Value Subscription Demo"
    help
      HoneyGUI system value subscription demo showing how a screen consumes
      values published by the platform.

config REALTEK_BUILD_REAL_VIEW
    bool "View Demo"
    select REALTEK_GUI_WIDGET_VIEW
    help
      HoneyGUI View Demo

config REALTEK_BUILD_EXAMPLE_LIST_WIDGET
    bool "List Widget Demo"
    select REALTEK_GUI_WIDGET_GEOMETRY
    select REALTEK_GUI_WIDGET_LIST
    help
      HoneyGUI List Demo

config REALTEK_BUILD_REAL_LITE_ARC
    bool "Geometry ARC Demo"
    select REALTEK_GUI_WIDGET_GEOMETRY
    help
      HoneyGUI Geometry ARC Demo

config REALTEK_BUILD_GEOMETRY_BENCH
    bool "Geometry Benchmark"
    select REALTEK_GUI_WIDGET_GEOMETRY
    help
      Measures rect, circle and arc raster and blit cost, payload size and
      cache sharing, then prints the result at init and returns. No UI: this
      exists to record numbers, not to be looked at.

config REALTEK_BUILD_REAL_LITE_RECT
    bool "Geometry RECT Demo"
    select REALTEK_GUI_WIDGET_GEOMETRY
    select REALTEK_GUI_WIDGET_VIEW
    help
      HoneyGUI Geometry RECT Demo

config REALTEK_BUILD_REAL_LITE_CIRCLE
    bool "Geometry CIRCLE Demo"
    select REALTEK_GUI_WIDGET_GEOMETRY
    help
      HoneyGUI Geometry CIRCLE Demo

config REALTEK_BUILD_EXAMPLE_QBCODE_WIDGET
    bool "QRCode Widget Demo"
    select REALTEK_GUI_WIDGET_QBCODE
    help
      HoneyGUI QRCode Widget Demo

config REALTEK_BUILD_GUI_466_466_DEMO
    bool "GUI Demo 466x466"
    select REALTEK_GUI_WIDGET_VIEW
    help
      HoneyGUI Demo for 466x466 resolution

config REALTEK_BUILD_GUI_240_240_DEMO
    bool "GUI Demo 240x240"
    help
      HoneyGUI Demo for 240x240 resolution

endchoice

menu "HoneyGUI Feature Configuration"

config REALTEK_BUILD_LETTER_SHELL
    bool "Enable LetterShell"
    default y
    help
      HoneyGUI Enable LetterShell

config REALTEK_BUILD_MONKEY_TEST
    bool "Enable Monkey Test Log"
    default n
    help
      HoneyGUI Enable Monkey Test Log

config REALTEK_H264_DECODER
            bool "Enable REALTEK_H264_DECODER support"
            default n

        if REALTEK_H264_DECODER

            config REALTEK_H264BSD
                bool "Enable REALTEK H264BSD"

        endif

config REALTEK_BUILD_GUI_BOX2D
    bool "Enable Box2D"
    default n
    help
      HoneyGUI Box2D physics engine

config REALTEK_BUILD_LITE3D
    bool "Enable Lite3D library"
    default n
    help
      HoneyGUI Enable Lite3D library

config REALTEK_BUILD_XML_LOADER
    bool "Enable XML Loader"
    default n
    select REALTEK_BUILD_LITE3D
    select REALTEK_H264_DECODER
    select REALTEK_GUI_WIDGET_VIEW
    select REALTEK_GUI_WIDGET_LIST
    select REALTEK_GUI_WIDGET_GEOMETRY
    select REALTEK_GUI_WIDGET_VIDEO
    help
      HoneyGUI Enable XML Loader (ezXML)

config REALTEK_BUILD_PARTICLE_SYSTEM
    bool "Enable Particle System"
    default n
    help
      HoneyGUI Enable lightweight particle system for visual effects
      including firework, trail, touch, snow and bubble effects.
      The particle system core is independent and can be used
      without HoneyGUI.

config REALTEK_MINIMP3
    bool "Enable Minimp3"
    default n
    help
      HoneyGUI Enable Minimp3 decoder

config REALTEK_BUILD_AUDIO
    bool "Enable Audio"
    default n
    help
      HoneyGUI Enable Audio, depending on "Minimp3" for simulator

endmenu

menu "HoneyGUI Widget Configuration"

config REALTEK_GUI_WIDGET_OBJ
    bool "gui_obj - base object (mandatory)"
    help
      Base object every widget inherits from. Locked on: core, server, dc
      and input all depend on it.

config REALTEK_GUI_WIDGET_IMG
    bool "gui_img - image display (mandatory in this release)"
    help
      Locked on: gui_text depends on gui_img. Becomes optional once
      engine/font is decoupled from gui_text.

config REALTEK_GUI_WIDGET_WIN
    bool "gui_win - window (mandatory in this release)"
    help
      Locked on: gui_text.h includes gui_win.h. Becomes optional once
      engine/font is decoupled from gui_text.

config REALTEK_GUI_WIDGET_TEXT
    bool "gui_text - text rendering (mandatory in this release)"
    help
      Locked on: the whole engine/font API is expressed in terms of
      gui_text_t (font_mem.h, font_ttf.h, font_stb.h, font_custom.h,
      font_mem_img.h, font_mem_matrix.h).

config REALTEK_GUI_WIDGET_VIEW
    bool "gui_view - view container, button, transitions"
    default y

config REALTEK_GUI_WIDGET_CANVAS
    bool "gui_canvas - custom drawing canvas"
    default y

config REALTEK_GUI_WIDGET_GEOMETRY
    bool "gui_geometry - arc, circle, rect"
    default y

config REALTEK_GUI_WIDGET_LIST
    bool "gui_list - scrollable list"
    default y
    select REALTEK_GUI_WIDGET_CANVAS
    select REALTEK_GUI_WIDGET_VIEW

config REALTEK_GUI_WIDGET_SVG
    bool "gui_svg - SVG vector graphics"
    default y

config REALTEK_GUI_WIDGET_GIF
    bool "gui_gif - animated GIF"
    default y

config REALTEK_GUI_WIDGET_GLASS
    bool "gui_glass - glass / blur effect"
    default y

config REALTEK_GUI_WIDGET_VIDEO
    bool "gui_video - video playback"
    default y

config REALTEK_GUI_WIDGET_LITE_VIDEO
    bool "gui_lite_video - MSV1 + Cinepak unified video"
    default y
    select REALTEK_GUI_WIDGET_VIDEO

config REALTEK_GUI_WIDGET_STREAM
    bool "gui_stream - live RAW video stream"
    default y
    select REALTEK_GUI_WIDGET_LITE_VIDEO

config REALTEK_GUI_WIDGET_QBCODE
    bool "gui_qbcode - barcode / QR code"
    default y

config REALTEK_GUI_WIDGET_SOCCER
    bool "gui_soccer - 2.5D soccer"
    default y

config REALTEK_GUI_WIDGET_CARD_LIST
    bool "gui_card_list - 3D perspective carousel"
    default y

config REALTEK_GUI_WIDGET_MENU_CELLULAR
    bool "gui_menu_cellular - cellular menu"
    default y

config REALTEK_GUI_WIDGET_LITE3D
    bool "gui_lite3d - 3D rendering widget"
    depends on REALTEK_BUILD_LITE3D
    default y
    help
      Widget adapter for the Lite3D library. Kept separate from
      REALTEK_BUILD_LITE3D so the library can be used without the widget.

config REALTEK_GUI_WIDGET_PARTICLE
    bool "gui_particle - particle effect widget"
    depends on REALTEK_BUILD_PARTICLE_SYSTEM
    default y
    select REALTEK_GUI_WIDGET_GEOMETRY
    help
      Widget adapter for the particle system core. The core in 3rd/particle
      is independent and can be used without HoneyGUI.

endmenu

endif # CONFIG_REALTEK_HONEYGUI
