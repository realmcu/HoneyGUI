from building import *

cwd = GetCurrentDir()
src = Glob('*.c') + Glob('*.cpp')

if GetDepend(['']):
    objs = DefineGroup('simulator/win32/port/sysval', src,
                       depend = [''], CPPPATH = [cwd])
else:
    objs = []

Return('objs')
